# Environment Variables
# Copy this file to .env and fill in your values

# Neon Database Connection String (for text/JSON data only)
# Get from: Neon Console → Project → Connection Details → Connection String
NEON_CONNECTION_STRING=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# Optional - Vercel API URL (usually auto-detected)
# VITE_NEON_API_URL=/api/config

# Production flag
PROD=false
VITE_VERCEL=0

# =============================================
# ARCHITECTURE NOTES:
# =============================================
# 1. GAMBAR BAWAAN (93 Produk Default):
#    → Tersimpan di folder public/assets/ (Statis, 100% Gratis & Unlimited)
#    → Tidak membutuhkan cloud storage atau database
#
# 2. GAMBAR KUSTOM (Upload Admin):
#    → Dikompresi otomatis ke WebP (~80KB per gambar)
#    → Disimpan sebagai Base64 Data URL di database (Neon DB)
#    → Batas: ~5MB LocalStorage + ~2MB Neon JSON
#
# 3. DATABASE (Neon DB Free Tier):
#    → 500MB total storage, 190 jam komputasi/bulan
#    → Hanya menyimpan teks/JSON (konfigurasi, harga, nama produk, dll)
#    → TIDAK menyimpan file gambar besar