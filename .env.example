# Environment Variables
# Copy this file to .env and fill in your values

# =============================================
# CLOUD DATABASE: Google Sheets API (GRATIS & UNLIMITED!)
# =============================================
# Ikuti panduan di scripts/google_sheets_api.js untuk setup
# Setelah deploy Google Apps Script, paste URL deployment di sini:
VITE_GSHEET_API_URL=https://script.google.com/macros/s/GANTI_DENGAN_URL_DEPLOYMENT_ANDA/exec

# =============================================
# IMAGE HOSTING: ImgBB API (GRATIS & UNLIMITED!)
# =============================================
# Daftar di https://api.imgbb.com/ lalu paste API key:
VITE_IMGBB_API_KEY=your_imgbb_api_key_here

# =============================================
# [LEGACY] Neon Database (TIDAK DIGUNAKAN LAGI - kuota habis)
# =============================================
# NEON_CONNECTION_STRING=postgresql://...

# Production flag
PROD=false
VITE_VERCEL=0

# =============================================
# ARSITEKTUR PENYIMPANAN:
# =============================================
# 1. GAMBAR BAWAAN (93 Produk Default):
#    → Tersimpan di folder public/assets/ (Statis, 100% Gratis & Unlimited)
#
# 2. GAMBAR KUSTOM (Upload Admin):
#    → Dikirim ke ImgBB API → dikembalikan sebagai URL pendek
#    → URL pendek disimpan ke Google Sheets (sangat ringan, <0.1 KB per gambar)
#    → Beban bandwidth gambar 100% ditanggung server ImgBB
#
# 3. DATABASE CLOUD (Google Sheets — GRATIS!):
#    → Unlimited storage untuk teks/JSON
#    → Tidak ada kuota transfer yang bisa habis
#    → Sinkronisasi otomatis lintas semua browser dan device