# Environment Variables
# Copy this file to .env and fill in your values

# =============================================
# CLOUD DATABASE: Turso / LibSQL
# =============================================
# Copy dari dashboard Turso:
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Optional admin override (fallback only)
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change-this-password

# =============================================
# IMAGE HOSTING: ImgBB API
# =============================================
# Daftar di https://api.imgbb.com/ lalu paste API key:
VITE_IMGBB_API_KEY=your_imgbb_api_key_here

# Production flag
PROD=false
VITE_VERCEL=0

# =============================================
# ARSITEKTUR PENYIMPANAN:
# =============================================
# 1. GAMBAR BAWAAN (93 Produk Default):
#    → Tersimpan di folder public/assets/ (Statis, 100% Gratis & Unlimited)
#
# 2. GAMBAR KUSTOM (Upload Admin):
#    → Dikirim ke ImgBB API → dikembalikan sebagai URL pendek
#    → URL pendek disimpan di Turso bersama metadata produk
#    → Beban bandwidth gambar 100% ditanggung server ImgBB

# 3. DATABASE CLOUD (Turso / LibSQL):
#    → Penyimpanan JSON dan metadata produk/site config
#    → Sinkronisasi lintas browser/device lewat /api/config
#    → Gambar tetap di-host eksternal, database hanya menyimpan URL